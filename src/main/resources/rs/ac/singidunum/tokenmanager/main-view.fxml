<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="220.0" prefWidth="326.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="rs.ac.singidunum.tokenmanager.controllers.TokenController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <top>
             <HBox>
                 <Button alignment="CENTER_RIGHT" contentDisplay="CENTER" mnemonicParsing="false" text="Create Token" onAction="#onCreateToken" textAlignment="CENTER" BorderPane.alignment="CENTER" />
                 <Region HBox.hgrow="ALWAYS"/>
             </HBox>
         </top>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
                  <ListView fx:id="tokenList" VBox.vgrow="ALWAYS"/>
            </VBox>
         </center>
      </BorderPane>
   </children>
</VBox>
